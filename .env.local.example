# Supabase — https://supabase.com/dashboard
# Use a SEPARATE project for local/staging vs production so dev never overwrites live data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Required on Netlify — auth emails (signup confirm, password reset) use this instead of localhost
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
# Server-only — required for global verified revoke/subscribe state on Netlify (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Data layer (posts, comments, forum, likes, etc.)
# local    = browser localStorage only — default, safe while building UI (no DB writes)
# supabase = persist to DB on explicit publish/admin actions only (see src/lib/data-mode.ts)
NEXT_PUBLIC_DATA_MODE=local

# Admin panel — comma-separated emails allowed to access /admin
NEXT_PUBLIC_ADMIN_EMAILS=linnea.n.a.s.hetty@outlook.com

# Stripe — https://dashboard.stripe.com
# Keys: https://dashboard.stripe.com/test/apikeys (never commit real keys)
# 1. Put STRIPE_SECRET_KEY below, then run: npm run stripe:setup-verification
#    (creates Product + $9/month Price; copies price_... for STRIPE_VERIFICATION_PRICE_ID)
# 2. Or create manually in Dashboard → Products
# 3. Webhook endpoint: https://your-domain.com/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed
# 4. Local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Second webhook (Stripe → Add endpoint → Connected accounts scope, same URL)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_VERIFICATION_PRICE_ID=price_...

# Payment Link when users click Subscribe (optional — defaults to buy.stripe.com link in code)
# NEXT_PUBLIC_STRIPE_VERIFICATION_PAYMENT_LINK=https://buy.stripe.com/your-link-id
# Local-only fake subscribe without Stripe (never enable in production):
# NEXT_PUBLIC_ALLOW_DEMO_VERIFICATION_SUBSCRIBE=true
# In Stripe → Payment Links → Edit → After payment → Redirect to (home OR settings):
# https://YOUR-DOMAIN/?verification=success&session_id={CHECKOUT_SESSION_ID}
# https://YOUR-DOMAIN/settings?tab=applications&verification=success&session_id={CHECKOUT_SESSION_ID}
# Server needs STRIPE_SECRET_KEY to confirm payment (Developers → API keys → Secret key)
# Run supabase/migrations/002_verification_platform.sql in Supabase SQL editor for global verification tables

# Platform commission on Shop sales (5–15%) — your fee via Stripe Connect application_fee
PLATFORM_COMMISSION_PERCENT=10
# Country for new Connect Express accounts (US, NO, etc.)
STRIPE_CONNECT_COUNTRY=US
# Local-only demo unlock when Stripe/Connect is not ready (never enable in production):
# NEXT_PUBLIC_ALLOW_DEMO_MARKETPLACE_PURCHASE=true
# Stripe Connect setup:
# 1. Dashboard → Connect → Get started → Express accounts
# 2. Webhook: add checkout.session.completed + account.updated (same /api/stripe/webhook)
# 3. Creators: Settings → Shop payouts → Stripe onboarding
# 4. Run supabase/migrations/003_marketplace_connect.sql for global purchase records
# 5. Run supabase/migrations/004_profile_avatar_media.sql and 005_platform_content.sql
#    (avatars + live posts/RPG topics visible to all visitors on Netlify)
# 6. Run supabase/migrations/006_post_code_vault.sql (paid template source for buyers)
