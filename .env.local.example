# Supabase — https://supabase.com/dashboard
# Use a SEPARATE project for local/staging vs production so dev never overwrites live data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Data layer (posts, comments, forum, likes, etc.)
# local    = browser localStorage only — default, safe while building UI (no DB writes)
# supabase = persist to DB on explicit publish/admin actions only (see src/lib/data-mode.ts)
NEXT_PUBLIC_DATA_MODE=local

# Admin panel — comma-separated emails allowed to access /admin
NEXT_PUBLIC_ADMIN_EMAILS=linnea.n.a.s.hetty@outlook.com

# Stripe — https://dashboard.stripe.com
# Keys: https://dashboard.stripe.com/test/apikeys (never commit real keys)
# 1. Put STRIPE_SECRET_KEY below, then run: npm run stripe:setup-verification
#    (creates Product + $9/month Price; copies price_... for STRIPE_VERIFICATION_PRICE_ID)
# 2. Or create manually in Dashboard → Products
# 3. Webhook endpoint: https://your-domain.com/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed
# 4. Local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_VERIFICATION_PRICE_ID=price_...

# Platform commission (5–15%)
PLATFORM_COMMISSION_PERCENT=10
